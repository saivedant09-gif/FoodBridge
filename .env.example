# MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=foodbridge
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# MongoDB Configuration (optional - core workflows work without it)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=foodbridge_meta
MONGO_ENABLED=false

# Application
APP_PORT=8080
JWT_SECRET=change-this-to-a-long-random-secret-string
SESSION_SECRET=change-this-session-secret

# Admin seed account (development only)
ADMIN_EMAIL=admin@foodbridge.local
ADMIN_PASSWORD=Admin@123
